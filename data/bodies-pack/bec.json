uka.saito/img/2014/04/21/7912819/0005.jpeg","alt":""},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"まあや生誕祭でお手紙を読んで\nなぜかちょっと泣いちゃった飛鳥。"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"あ、ちなみにまあやさんは一粒も涙をみせず\n終始太陽のような笑顔で得意の英語を...\nえ？得意...だよね？"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"とりゃあ"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/asuka.saito/img/files/46/_pre/blog/asuka.saito/img/2014/04/21/7912819/0006.jpeg","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"とりゃあ～"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/asuka.saito/img/files/46/_pre/blog/asuka.saito/img/2014/04/21/7912819/0007.jpeg","alt":""},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/asuka.saito/img/files/46/_pre/blog/asuka.saito/img/2014/04/21/7912819/0008.jpeg","alt":""},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/asuka.saito/img/files/46/_pre/blog/asuka.saito/img/2014/04/21/7912819/0009.jpeg","alt":""}],"source":"archive"},"crw-nogi-34021":{"blocks":[{"type":"paragraph","text":"みなさまこんばんは！"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"北野日奈子です(｡・・｡)♪"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"今日は台風大丈夫でしたか？。。。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"雨、風が凄くて\nこわかった！！！"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"でも、傘は守り抜いたよっ( ˘ｰωｰ˘ )"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"なぜかってね、"},{"type":"break"},{"type":"paragraph","text":"妹の傘を勝手に持っていって\n使ったからです( ˘ｰωｰ˘ )"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"無事に無傷で返すことができました！"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/hi