":"paragraph","text":"ばいっっっ"}],"source":"archive"},"crw-nogi-6483":{"blocks":[{"type":"paragraph","text":"こんばんわかつきっ(｀_´)ゞ！"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/yumi.wakatsuki/img/blog/photos/entry/2012/08/12/7109792/0000.jpeg","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"もう"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"頑張るしかないから。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"明日はあるだけの全力を"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"出すだけです。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"乃木坂46の初めての正式ライブ"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"初ライブだからライブをやって"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"やっぱり"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"私達はまだまだだと"},{"type":"break"},{"type":"paragraph","text":"知らされてしまうかもしれない"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"でも"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"これは次の目的地に行くための"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"大切な大切な初ライブだから。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"失敗しないようにじゃなくって"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"成功できるようにやりたい"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"上がりしょうで不器用で力みやすい私だから色々不安だけど、"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"私、頑張ります。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"いや、"},{"type":"break"},{"type":"break"},{"type":"break"},{"t