ithub.io/n46-crawler/mb/yuuri.saito/img/blog/yuuri.saito/img/2017/01/13/1054923/0026.jpeg","alt":""},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/yuuri.saito/img/blog/yuuri.saito/img/2017/01/13/1054923/0027.jpeg","alt":""},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/yuuri.saito/img/blog/yuuri.saito/img/2017/01/13/1054923/0028.jpeg","alt":""},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/yuuri.saito/img/blog/yuuri.saito/img/2017/01/13/1054923/0029.jpeg","alt":""},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/yuuri.saito/img/blog/yuuri.saito/img/2017/01/13/1054923/0030.jpeg","alt":""},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/yuuri.saito/img/blog/yuuri.saito/img/2017/01/13/1054923/0031.jpeg","alt":""},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/yuuri.saito/img/blog/yuuri.saito/img/2017/01/13/1054923/0032.jpeg","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"こんなに一気にお手紙書いたのは\nはじめてでした( ´･ᴗ･` )\nでもとってもやりがいのある企画ですし\nふぁみたんが喜んで頂けるのが1番\nなのでこれからも続けて行きたいなと\n思います♡♡♡♡♡♡♡♡♡♡♡♡"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"その時を楽しみに今回選ばれなかった方は\nまた再チャレンジしてみてね？"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"次回は10/13でした（笑）\nそれまで長すぎる（笑）"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"世間的には不吉なイメージの日だけど\nこういうことや13日の金曜日という\n歌をもっと知ってもらってまた\n今までとは違った13日を感じて\nもらえたらいいな〜"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"それでは明日の握手会\n来れる方は色んなお話しようね？\n来れない方はんーーーーーーー\n心で念じといて（笑）"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"たんたんたん ゆったんたん( •ㅈ• )"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"_"}],"source":"archive"},"crw-nogi-21646":{"blocks":[{"type":"paragraph","text":"いきなりだけどね、インターネットで\n遠くの方にも「のぎ天」の\n存在を知ってもらえるといいな〜\nありがたいです、本当に♡♡♡"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"そう「のぎ天」といえば江ノ島・鎌倉\nご褒美ロケがアップされてましたね〜"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/yuuri.saito/img/blog/yuuri.saito/img/2014/11/12/9754078/0000.jpeg","alt":""},{"type":"break"},{"type":"paragraph","text":"もう、見て頂けたかな？"},{"type":"break"},{"type":"paragraph","text":"鎌倉情緒あるかんざしのお店に\n入ってみるとお店のお母さんが\nとっても優しくてかんざしを\nつけてくれたり૧(●´৺`●)૭"},{"type":"break"},{"type":"paragraph","text":"これで、ワシも少しは和美人に\nなってたりするのかな。笑い"},{"type":"break"},{"type":"paragraph","text":"あれ、欲しかったな〜\n時間があんまなくて皆お土産に\n買いたかったのにかえなかったんだ。泣"},{"type":"break"},{"type":"paragraph","text":"かぼちゃ味のきんつばは\n今でも忘れないくらい\n美味しくで周りの衣ついてるのが\n不思議でたまらなかったけど\n美味しすぎて ͛꒰ू ऀ•̥́ꈊ͒ੁ•ૅू॰˳ऀ꒱ ͟͟͞  ̊ ̥  ̥"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"この日は1日食べてしかいなかった〜\n鎌倉ハムも食べれて幸せ"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/yuuri.saito/img/blog/yuuri.saito/img/2014/11/12/9754078/0001.jpeg","alt":""},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/yuuri.saito/img/blog/yuuri.saito/img/2014/11/12/9754078/0002.jpeg","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"ご褒美ロケとっても堪能出来ました\nそれでは素敵な景色とばいばい〜"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/yuuri.saito/img/blog/yuuri.saito/img/2014/11/12/9754078/0003.jpeg","alt":""},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"さっきまでお仕事中で\nらりんが左肩にマーキングしてきて\nみり愛が右肩にもたれかかってて\nとっても両手に華と言いたいけど\n確実に左肩は迷惑なだけだった(´°ω°`)"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"ワシにはみり愛だけで充分でした♡♡♡"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"あ〜みり愛らぶーー♡♡♡♡"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"たんたんたん ゆったんたん( •ㅈ• )"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"_"}],"source":"archive"},"crw-nogi-3488":{"blocks":[{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/ami.noujo/img/blog/photos/entry/2012/03/13/9797948/0000.jpeg","alt":""},{"type":"break"},{"type":"paragraph","text":"こにゃちわ！"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"なんかね、"},{"type":"break"},{"type":"paragraph","text":"あみが普通に何も言ってもないし動いてもないのに、"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"最近やたらメンバーに\n「うちさあ本当あみあみツボなんだよね〜フハハハ」"},{"type":"break"},{"type":"paragraph","text":"って言われて"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"あみは\n↓↓\n「............＼(//△//)／...！」"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"みたいな感じの反応で返すみたいなのが"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"最近よく繰り広げられます。"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"え...これは有り難く受け取って"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"...いいのよね？"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"あーのー今究極にペットが飼いたい気分。"},{"type":"break"},{"type":"paragraph","text":"なんか可愛がりたい。"},{"type":"break"},{"type":"paragraph","text":"まさかあみにもこんな母性本能が生まれるとわ......"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"ビックリだＺ！！！！！"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"あ、そういえば"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"今日朝の電車の中で漂った"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"ペペロンチーノときっと焼きたてのパンみたいなにおい香らせてた人誰だったんだろう........."},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"気になるなあ。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"木になるなあ。"}],"source":"archive"},"crw-nogi-3716":{"blocks":[{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/rina.ikoma/img/blog/photos/entry/2012/03/24/9590577/0000.jpeg","alt":""},{"type":"paragraph","text":"どうも生駒里奈ですよん！"},{"type":"break"},{"type":"paragraph","text":"今日は名古屋で個別握手会が行われました〜(´∀｀)\n乃木坂４６では初めての個別握手会でした！"},{"type":"break"},{"type":"paragraph","text":"しかも私服ですって！\n今日は珍しくガーリーな感じで女の子らしくワンピースで登場しました。"},{"type":"break"},{"type":"paragraph","text":"恥ずかしいかった(*/□＼*)"},{"type":"break"},{"type":"paragraph","text":"みなさん来てくださってありがとうございました"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/rina.ikoma/img/blog/photos/entry/2012/03/24/9590577/0001.gif","alt":""},{"type":"break"},{"type":"paragraph","text":"まだまだ慣れない部分もありました〜(´・д・｀)"},{"type":"break"},{"type":"paragraph","text":"でもすごく楽しい"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/rina.ikoma/img/blog/photos/entry/2012/03/24/9590577/0002.gif","alt":""},{"type":"paragraph","text":"握手会になったかなと思います!!\nあとみなさんの服装も毎回実は楽しみにしてるんですよ！\n乃木坂ジャージに\n乃木坂半纏\nあとキャラクターのキグルミさんもいてにぎやかでしたね〜ヽ(・∀・)ノ"},{"type":"break"},{"type":"paragraph","text":"でも大体のみなさんの顔を覚えました！"},{"type":"break"},{"type":"paragraph","text":"ただ名前が...\nなかなか覚えれなくてごめんなさい...o(T□T)o"},{"type":"break"},{"type":"paragraph","text":"だからみなさんお願いです!!\n生駒ちゃんに優しく教えてやってください！"},{"type":"break"},{"type":"paragraph","text":"すると頭の悪い生駒ちゃんはちゃんと覚えると思います!!(汗)"},{"type":"break"},{"type":"paragraph","text":"でもみなさんとの会話の中でこれからどう考えて行動していこうか、気持ちをどうもっていくかとかいろいろ考えることができました！"},{"type":"break"},{"type":"paragraph","text":"いつもありがとうございます！"},{"type":"break"},{"type":"paragraph","text":"お陰で成長することが出来ます＼(^o^)／"},{"type":"break"},{"type":"paragraph","text":"あと今日これなかったみなさん!!"},{"type":"break"},{"ty