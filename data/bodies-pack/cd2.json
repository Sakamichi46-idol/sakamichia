ages.sakamichi.co/blogs/01JHJ0XKKKDJAZVQ6YCG3G5SSW","alt":""},{"type":"paragraph","text":">\n \n 是非ひらがなグッズを集めて私達とお揃いにしましょう(^。^)！\n \n \n "},{"type":"image","src":"https://images.sakamichi.co/blogs/01JHJ0XN2GEM1TEM1VVEJ8B0DQ","alt":""},{"type":"paragraph","text":">\n \n 加藤史帆"}],"source":"archive"},"crw-nogi-14668":{"blocks":[{"type":"paragraph","text":"おばんだす！"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"鈴木絢音です(^^)♡"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/40006/img/files/46/_pre/blog/kenkyusei/img/2013/10/17/0823377/0000.jpeg","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"今日は学校の音楽祭でした"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/40006/img/files/46/_pre/blog/kenkyusei/img/2013/10/17/0823377/0001.gif","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"私のクラスは"},{"type":"break"},{"type":"paragraph","text":"オペレッタにチャレンジ！！"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"数ヶ月前から準備に取り掛かり"},{"type":"break"},{"type":"paragraph","text":"本番を迎えました。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"クラスのみんなと"},{"type":"break"},{"type":"paragraph","text":"一つのものを創り上げ、"},{"type":"break"},{"type":"paragraph","text":"一つになれたような気がして"},{"type":"break"},{"type":"paragraph","text":"嬉しかったです"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/40006/img/files/46/_pre/blog/kenkyusei/img/2013/10/17/0823377/0002.gif","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"みんな、ありがとう（ ;  ; ）♡"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"私の親友はプリンセス役！"},{"type":"break"},{"t