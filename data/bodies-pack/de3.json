s.sakamichi.co/blogs/01JJ4E89CPHPBG30EFFGD3VH67","alt":""},{"type":"paragraph","text":">"},{"type":"image","src":"https://images.sakamichi.co/blogs/01JJ4E8AETMN3F4VDK3225DT2Y","alt":""},{"type":"paragraph","text":">\nどれがすーじでしょうっ"},{"type":"break"},{"type":"paragraph","text":"それじゃ！パリピース✌(’ω’)"}],"source":"archive"},"sba-hinata-21749":{"blocks":[{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"こんにちは"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"高本彩花です"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://images.sakamichi.co/blogs/01JHH1D2T38CR5Q3SJF0Z25F90","alt":""},{"type":"paragraph","text":">"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"録画していたアナ雪みれたよ〜うれぴ〜\nちなみにアナ雪は映画館では見てないのですがお友達がDVDを持っていたのでその子のお家に行く度に私が見たいと言って見ていました\nアナ雪は、いつ見ても感動します\nディズニー映画だぁぁぁぁいすき"},{"type":"break"},{"type":"paragraph","text":"今日はアナをイメージして三つ編みにしてみたのだ"},{"type":"break"},{"type":"paragraph","text":"そして今、モアナの歌にすごくハマっていますモアナと伝説の海も見たいなぁ"},{"type":"break"},{"type":"paragraph","text":"ラ・ラ・ランドも見たい"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"見たい映画は沢山あるけど、いつも公開中に見に行けないんです"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"もう一つ、アナの髪型の真似してみたの"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://images.sakamichi.co/blogs/01JHH1D3RDPEWYZ4TB4HM7FTD8","alt":""},{"type":"paragraph","text":">"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"完璧な自己満足です"},{"type":"break"},{"type":"paragraph","text":"中学生くらいの頃から独学で編み込みを学んで今では裏も表も出来るようになりました\n正しいのかは謎です\nヘアアレンジがすごく好きで暇な時は髪の毛を触ります\n浴衣を着た時のアレンジが特に好きでお祭りの時は友達に頼まれたりしてよくやってました"},{"type":"break"},{"type":"paragraph","text":"最近はあんまりしなくなったけど遊んだりする日はストレー