{"v3_d2cbf50388cc61573b412dc4":{"blocks":[{"type":"paragraph","text":"\n            ﻿"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"\nこんにちは！"},{"type":"break"},{"type":"paragraph","text":"\nブログ開いて下さりありがとうございます🐈‍⬛"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"\n増本綺良です🌸"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://sakamichi-biyori.pages.dev/blog/public/media/v3_d2cbf50388cc61573b412dc4/0.jpg","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"\n最後のブログです"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://sakamichi-biyori.pages.dev/blog/public/media/v3_d2cbf50388cc61573b412dc4/1.jpg","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"\n卒業セレモニー"},{"type":"break"},{"type":"paragraph","text":"\nドレスの色は薄オレンジにして頂きました！"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"\nハッキリとした色味ではなく"},{"type":"break"},{"type":"paragraph","text":"\n照明で白に見えるくらいの淡さでお願いしますとお伝えして、とっても可愛い色になりました✨️"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://sakamichi-biyori.pages.dev/blog/public/media/v3_d2cbf50388cc61573b412dc4/2.jpg","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"\nレースの中の刺繍が繊細で可愛いくて"},{"type":"break"},{"type":"paragraph","text":"\nとってもお気に入りです！💐"},{"type":"break"},{"type":"paragraph","text":"\n見る度にテンション上がってました🥳"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"\nたくさんこだわりを聞いて下さって、"},{"type":"break"},{"type":"paragraph","text":"\n理想以上の仕上がりで本当に大好きな一着です🌸"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://sakamichi-biyori.pages.dev/blog/public/media/v3_d2cbf50388cc61573b412dc4/3.jpg","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"\n✨️✨️"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"\n前のサイリウムカラーであるエメラルドグリーンも良いなぁなんて結構悩みもしたんですけど、"},{"type":"break"},{"type":"paragraph","text":"\n卒業セレモニーは自分も皆さんも笑顔で終わりたいという気持ちがずっとあったので"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"\n会場を笑顔で照らせる太陽になろうとオレンジに決めました！🍊"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://sakamichi-biyori.pages.dev/blog/public/media/v3_d2cbf50388cc61573b412dc4/4.jpg","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"\n我ながらいい決め方"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"\nしかし"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://sakamichi-biyori.pages.dev/blog/public/media/v3_d2cbf50388cc61573b412dc4/5.jpg","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"\n太陽、敗北"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"\n皆さんの方が眩しかったです☀️"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"\nいつだって照らして下さっていたのは皆さんの方だったんだなと改めて感じました☺️"},{"type":"break"},{"type":"paragraph","text":"\nありがとう"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://sakamichi-biyori.pages.dev/blog/public/media/v3_d2cbf50388cc61573b412dc4/6.jpg","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://sakamichi-biyori.pages.dev/blog/public/media/v3_d2cbf50388cc61573b412dc4/7.jpg","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"\n寂しい気持ちになるのはお別れの後にいつでも出来てしまうので、一緒に居られる限られた時間は楽しく笑顔でいたい。"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"\nそんな私の最後の願いを叶えて下さってありがとうございました！"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"\n涙を流しながらも笑顔で居てくださる皆さんのお顔、よく見えてました☺️"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"bre