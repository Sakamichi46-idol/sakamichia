o/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/04/12/0139847/0003.gif","alt":""}],"source":"archive"},"sba-hinata-24509":{"blocks":[{"type":"break"},{"type":"paragraph","text":" \n \n \n \n \n \n しほちゃんお誕生日おめでとう！\n \n \n へにょへにょしてるけど\n いつもひらがなのとこを考えてて\n 意外としっかりしてて\n みんなのことを見てるしほちゃんを\n 陰ながら尊敬してます✨\n \n \n しほちゃんが\n 楽屋とかでキャーキャーしてる場所は\n いつも明るい気がする(*≧∀≦*)\n \n \n 20歳も仲良くしてね💓💓\n また今度遊びに行こうね〜〜\n \n \n \n \n そして私としほちゃん\n 写真を全く撮ってない！\n \n 1枚も無いことが判明した！\n \n \n 今度撮ろう！！\n \n \n \n 20歳も素敵な1年にしてください🎂\n \n \n 改めて\n お誕生日おめでとう🎉"}],"source":"archive"},"crw-nogi-3590":{"blocks":[{"type":"paragraph","text":"昨日のチャリティーイベントでは\n生憎の悪天候の中、\n沢山の方々にご参加いただき本当にありがとうございました!!!"},{"type":"break"},{"type":"paragraph","text":"皆さんが協力してくださったお陰で\n笑顔、元気、熱いパワーが\nちゃんと東北の方々に届いたのではないかと思っています★!"},{"type":"break"},{"type":"paragraph","text":"あの日から一年という月日が経ったけれど、まだまだ震災の爪痕は消えていません"},{"type":"break"},{"type":"paragraph","text":"一日でも早い復興のためにも、\nこれからも力を合わせていかないと!"},{"type":"break"},{"type":"paragraph","text":"改めて色々と考えさせられるイベントとなりました。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"そして......"},{"type":"break"},{"type":"paragraph","text":"セカンドシングル選抜発表、\n遂に先程の乃木どこ?で発表されました"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"今回、セカンドシングル七福神に選んで頂きました。"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"とても驚きました。\n正直に言うと、自分はもう七福神に戻る日は来ないと思っていました。"},{"type":"break"},{"type":"paragraph","text":"自分の脳内でまだ整理が出来ていない状態です；"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"なので、この事については次の記事でゆっくり話したいです。"},{"type":"break"},{"type":"paragraph","text":"一日だけ待っていただけないでしょうか??"},{"type":"break"},{"type":"paragraph","text":"よろしくお願いします"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"ですが一先ず今は......"},{"type":"break"},{"type":"paragraph","text":"皆様に感謝の気持ちを込めて、短いですが\n本当にありがとうございます。"},{"type":"break"},{"type":"paragraph","text":"選んでいただいたからには、\n全力でいきます!!!"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"改めて、よろしくお願いします!!"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"桜井玲香"}],"source":"archive"},"crw-nogi-9165":{"blocks":[{"type":"paragraph","text":"そろそろ冬休みになるでやんすぅ。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"はーいそんな能條ちゃん今日も元気元気でやんすぅ。"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/ami.noujo/img/blog/photos/entry/2012/12/13/2489879/0000.jpeg","alt":""},{"type":"break"},{"type":"paragraph","text":"ピース、いえい。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"はぁい！そして４ｔｈの個人PVが少しだけUPされてましたが......"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"私の苦手なもの。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"『臭い食べ物』"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":".........いや、誰でも苦手じゃん。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"って思ったよねそこのあなた。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"うん今あみの隣で居眠りなさってるママにも言われた。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"それにしても気持ち良さそうに眠ってるやがる。能條ママ。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"まるで幼い小熊のようだ。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"はい話ズレた。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"いやー正直言っていいか？"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"あみね、これが苦手なのっ！！！！ってもんが特にこれといってなかったの。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"良いことよね？"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"だからまあみんな無難に嫌いで苦手な臭いものをフィーチャーさせていただきました。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/ami.noujo/img/blog/photos/entry/2012/12/13/2489879/0001.jpeg","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"この情けない背中を見てちょうだい。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"可哀想に..."},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"余程臭いもの食べさせられたのね。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"もー大人ってこわいっ笑"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"恐らく皆様が想像なさってるものをはるかに超える臭いもの食べてきました。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"いやぁよくやったよ18歳。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"我ながら、かなり頑張りました。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"皆様、CDをご購入の際は是非、"},{"type":"break"},{"type":"paragraph","text":"能條愛未のPV、ご覧になってみてはいかがでしょうか。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/ami.noujo/img/blog/photos/entry/2012/12/13/2489879/0002.jpeg","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"質問返そ。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"Q  あっ、そうだ。一つ質問。唐突だけど、くまモン好き？"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"A、くまもん？？？愛嬌あって可愛いと思うよ。笑"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"Q  あみあみはリレーの選手やったことある？？"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"A、あるよーこう見えてな！！あみはな！足早かったんだぜ？過去形..."},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"Q   、アイドルのイベント行くことをヲタ活っていうんだけど"},{"type":"break"},{"type":"paragraph","text":"あみの握手行ったりあみに会いに行くときは「あみ活」って言ってもいい？照"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"A、みんなたくさんあみ活だ！"},{"type":"break"},{"type":"paragraph","text":"決まり！ (๑╹∀╹๑)"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"Q、  愛未ちゃんホラー好きなのかな？"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"A、ホラーはねえわりかし好きなのよ～。後で見てお風呂は入れなくなって後悔するのわかってるのにね、笑"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"Q、好きな歌手とかおるー？"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"*A*清水翔太さん"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"*Q  *「サンタさんから貰ったプレゼントの中でいちばん嬉しかったものは何ですか!?」"},{"type":"break"},{"type":"paragraph","text":"ロマンチストあみあみの回答待ってます"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"*A*えっとね、バービーちゃんのピンクハウス！！！！！！どうだ！！！"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"Q、  あみのことが１番好きだから他のアイドルのイベントも行っていい？"},{"type":"break"},{"type":"paragraph","text":"どんなに釣られてもあみが１番好きって自信はある！！！"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"A、ぇえ～あんま行ってほしくな(￣^￣..."},{"type":"break"},{"type":"paragraph","text":"でもそんなに自信あるなら行ってみては？"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"Q 、 あみあみゎ握手会のファンの"},{"type":"break"},{"type":"paragraph","text":"人たちがどんな格好して来てくれたら嬉しい？"},{"type":"break"},{"type":"paragraph","text":"あとどんな格好してきてくれたら可愛いなとおもう？"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"Ａ、なんか個性的な着ぐるみとか着てきてくれたりすると、おっ！ってなるよ(^O^)／"},{"type":"break"},{"type":"paragraph","text":"後は伝説のあみあみのにっこりＴシャツね！！"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"以上！"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"せーのでつま先伸ばすよ？"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"せーの。せーで。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/ami.noujo/img/blog/photos/entry/2012/12/13/2489879/0003.jpeg","alt":""},{"type":"break"},{"type":"paragraph","text":"まひろすきー"}],"source":"archive"},"sba-nogi-40204":{"blocks":[{"type":"paragraph","text":"          お疲れ様です、ももこです "},{"type":"image","src":"https://images.sakamichi.co/blogs/01JHEW157AN377MHD7SQJPTJ2M","alt":""},{"type":"paragraph","text":">           昨日はTIF！ 周りにアイドルさんだらけだった(ﾟДﾟ)   すごい盛り上りでびっくりだったし 会場は熱気と気温と湿気で夕方でも ものすごく暑かったですが、みなさん 熱中症とかなったりしてないですかね？   ももこ汗っかきなので、今日の目標の１つは 汗をかかない！って言ってるのに毎回 立つだけで汗かいて前髪なくなるの嫌！   だけど楽しかったんだー   大トリをやらせていただいてすこし不安と 緊張でしたが嬉しかったです！ 先輩方が来てくれる安心感はすごかった✨ ありがとうございました！             8月2日はFNSうたの夏まつり！   ぐるぐるカーテンとひと夏の長さより...を 披露しまた！ 1列なってカメラに抜かれるところ 最後まで何しようか迷った結果がパンチ〜 去年の冬初めてFNSに出させてもらった 時よりは緊張せずに出来たかなと思います！       FNS前の休憩時間、すごく眠かったんです   ももこ〜起きろ〜がんばれ〜 メイクしてきなさい〜   って言われてやっと起きました！ くっついて寝てしまいご迷惑 おかけしました(°_°)♡       8月4日はミュージックステーション   ものすごーくすごーくすごく緊張でした... ランスルーの時は、少し涙流してしまい、 階段を降りるのも緊張するし、座ってるだけ でも、話すのも全部緊張でたくさんで、 本番がすごく怖かったです。   ももこ、泣かない、大丈夫だから。 笑顔だよ！って隣で言ってくれる まい姉さんはお姉ちゃんみたいな存在です 本番、階段降りて登場する時、不安すぎて 一緒行きましょう...って言ってしまって 助けてもらいました最後まで隣でずっと 助けてくれました。   高山さんにも真夏さんにもトークの時 ずっと助けてもらいました、。 全ての先輩方が毎回毎回助けてくれて なんとかステージに立てています！ 優しい先輩方に感謝ばかりです(TT)   すこしずつ成長していかなきゃなぁ。               乃木坂工事中見てくださった方ー！     18枚目ヒット祈願は   スキューバダイビングでした！！     水の中は、すごく疲れる事がわかりました 背負ってるのもすごく重くて 歩くのもたいへーん！ でもたくさんの魚が本当に綺麗だった！ 透明度がよかったらもっと綺麗 なんだろうなと思いながらライセンスの 資格を取る事が出来ました✨ 筆記試験はとってもとっても眠かった ですが...ギリギリ合格できてセーフって ところでしたね〜〜   海ガメ見られるのでしょうか               7月29日発売   月刊エンタメさん よだよだの乗せてもらってます！     7月31日発売   BUBKAさん ソログラビアです！ メディア賞以外でソロで長い時間 撮影してもらったのは初めてでした！ 先月号の高山さんと一緒に江ノ島に 行ったんです！楽しかったな〜〜 "},{"type":"image","src":"https://images.sakamichi.co/blogs/01JHEW168HCWFWNQC90NNVN5Y1","alt":""},{"type":"paragraph","text":">     8月1日発売   TVガイドAlpha EPISODE Gさん よだよだと乗せてもらいました！     8月2日発売   TVガイドさん これもよだよだと〜！     8月3日発売   週刊少年チャンピオンさん みーちゃんとしーちゃんと3人で のせてもらいました！ "},{"type":"image","src":"https://images.sakamichi.co/blogs/01JHEW178G2MJDE5MW40C81CC4","alt":""},{"type":"paragraph","text":">     8月7日今日発売！   ヤングマガジンさん まい姉さんと表紙させてもらいました！ 遊園地行って、すごく楽しかったんです〜 ゴーカート運転してもらったり 優しくて面白くて本当に！♡   たまに嫌いと言われます...笑   でも愛情表現ですってー(￣▽￣)✨ 好きですかー？って聞いたら だいすき、言ってくれたもん〜〜 やめなさい！そういう事聞くの！ と言われちゃったんですが、、笑   "},{"type":"image","src":"https://images.sakamichi.co/blogs/01JHEW188K1M2NGSG54KF2QQFE","alt":""},{"type":"paragraph","text":">     "},{"type":"image","src":"https://images.sakamichi.co/blogs/01JHEW199Z2RKB9QQPJVVYH381","alt":""},{"type":"paragraph","text":"> ももこ幸せそう！ 一緒に居てもらえると楽しいんです(^^)           ももももも〜                   またね！"}],"source":"archive"},"sba-hinata-26470":{"blocks":[{"type":"paragraph","text":"       こんばんは！"},{"type":"break"},{"type":"paragraph","text":"けやき坂46の加藤史帆です！"},{"type":"image","src":"https://images.sakamichi.co/blogs/01JHJ27QBQB11QBQ2BTMCEXSGC","alt":""},{"type":"paragraph","text":">ダブルピース"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"昨日は東京ビックサイトで7thシングルの個別握手会でした⭐️"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"お越し下さった皆さん、ありがとうございました！\n何人かに体調大丈夫？って聞かれてしまったのですが、昨日は喉の調子が悪くあまり大きな声が出せなかったのでそう思わせてしまったのかもしれません、、ごめんなさい！\nもうほぼ治ったので大丈夫です🙂！"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"昨日は10月唯一の個別握手会ということで、一日中仮装をしました👻\n多くのメンバーが仮装していたし、ファンの方も仮装している方がいて少し早めのハロウィンが出来て楽しかったです🎃🎃"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"1部"},{"type":"image","src":"https://images.sakamichi.co/blogs/01JHJ27RB9M2ZVEZPMNDGYP4Y4","alt":""},{"type":"paragraph","text":">ポゥッッ！\nこの写真じゃわかりませんね、、、"},{"type":"break"},{"type":"image","src":"https://images.sakamichi.co/blogs/01JHJ27SH4GV1ZHW1W81HS2ND0","alt":""},{"type":"paragraph","text":">(お辞儀が深いんじゃ、、、)"},{"type":"break"},{"type":"paragraph","text":"とても可愛くないですか？この衣装！！"},{"type":"break"},{"type":"paragraph","text":"ささく(佐々木久美)とお出かけした時にこれを着ている方がいて、2人で一目惚れしたんです！"},{"type":"break"},{"type":"paragraph","text":"ということで、"},{"type":"image","src":"https://images.sakamichi.co/blogs/01JHJ27TH9J8FX9768KEAXBGY2","alt":""},{"type":"paragraph","text":">ささくとお揃いで着ました👻\nすずかちゃん(富田鈴花)もこさかな(小坂菜緒)も同じのを着ていたから、一緒に写真撮って貰えば良かったな～💡"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"2部"},{"type":"image","src":"https://images.sakamichi.co/blogs/01JHJ27VPZXQ5ZRE1YXSB8JV3G","alt":""},{"type":"paragraph","text":">"},{"type":"image","src":"https://images.sakamichi.co/blogs/01JHJ27WR9JE30NBG178ASA17N","alt":""},{"type":"paragraph","text":">丁度シリアルを食べている時にささくが撮ってくれました📸\n                                                            あーんしてるんだよ(照)"},{"type":"break"},{"type":"paragraph","text":"ささくに看病してる人みたいって言われました( ・∇・)"},{"type":"break"},{"type":"paragraph","text":"2部ではさりげなく髪型をツインテールに変えました😳"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"4部と5部は服装も髪型も同じだったので、共に紹介しますね！"},{"type":"image","src":"https://images.sakamichi.co/blogs/01JHJ27XQECJKCR6H0M480E275","alt":""},{"type":"paragraph","text":">ついにすることが出来た、、、"},{"type":"break"},{"type":"paragraph","text":"進撃の巨人 ミカサ ！！！"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"ずっとコスチュームは持っていたのですが、着るチャンスが無かったのでようやく着ることが出来て幸せでした😳\nファンの皆さんも進撃好きな方が多く、ミカサ ！？って気付いてくれて嬉しかったです💗"},{"type":"break"},{"type":"image","src":"https://images.sakamichi.co/blogs/01JHJ27YVY2FZNC0WC25T61KA8","alt":""},{"type":"paragraph","text":">三部はおたけ(高本彩花)も進撃コス！！おたけはサシャ風だったみたいです✨"},{"type":"break"},{"type":"paragraph","text":"ヨッ！ポニーテールの女王！！！！！！"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"いつかプライベートでカツラもゲットしてちゃんとコスプレしてみたいな～"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"最後に贈っていただいたお花を紹介します🌹"},{"type":"image","src":"https://images.sakamichi.co/blogs/01JHJ2803W10SBCXRD1YHESKBG","alt":""},{"type":"paragraph","text":">\n全て可愛い😍\n昨日は全体的にキュート感というかファンタジー感があって加藤はときめきました！\n素敵なお花を本当にいつもありがとうございます！！"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"改めて、昨日会いに来て下さった皆さんありがとうございました！\n風邪を引いている方が多く見られたので、体調には気を付けて明日から1週間 また一緒に頑張りましょう👻✨"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://images.sakamichi.co/blogs/01JHJ2816CP0870J2QW8AM3QT8","alt":""},{"type":"paragraph","text":">(お化けを見たメイドっていうテーマの写真)"},{"type":"break"},{"type":"paragraph","text":"最後までお読みいただきありがとうございました(・ω・)\n                                                                   加藤史帆"}],"source":"archive"}}