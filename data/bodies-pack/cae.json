569e591d1-02.jpg","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"今年初プールだ🚰"},{"type":"break"},{"type":"paragraph","text":"足湯ならぬ足水"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://www.nogizaka46.com/images/46/e85/0b73a0ce226ea47b39e2569e591d1-03.jpg","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"暑い一日やったけど楽しかったです"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"アイス屋さんに行ったんだけど「好きなの頼んでいいよ〜」って言ってくださって、食べたことないなと思ってちんすこう味を、頼んだんです。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://www.nogizaka46.com/images/46/e85/0b73a0ce226ea47b39e2569e591d1-04.jpg","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"そしたらこの色合い！"},{"type":"break"},{"type":"paragraph","text":"というかメニュー表に映ってたんだけど！"},{"type":"break"},{"type":"paragraph","text":"なんも考えてなかったよーー笑笑"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"流石に画面に映なすぎる色を選んでしまった…  "},{"type":"break"},{"type":"paragraph","text":"反省反省"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"美味しかったからいい！"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"と、そんな思い出も撮影中ありました"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"そして、特典で自分が大きくポスターがついてくるそうです!!"},{"type":"break"},{"type":"paragraph","text":"嬉しいけれどひとつ心配なことがあるんですそれはね私は実家に帰ったら自分の部屋に貼ってありそうってこと"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"ちなみにすでに、実家のまおの部屋の壁には彩とみくとさつきがいます。もうちょい居たかも笑"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"実家に帰ったら何故か5期のメンバーに囲まれて寝てるんだよね〜"},{"type":"break"},{"type":"paragraph","text":"笑"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"次帰った時どうなってるか楽しみです"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"またまた書きます🍀"}],"source":"official"},"ofc-n46-102384":{"blocks":[{"type":"paragraph","text":"昨日ね、ふとテレビをつけたら魔女の宅急便がやってたんだ〜"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"まおとみくとぼーっと観てたよ🐈‍⬛⸒⸒⸒⸒"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://www.nogizaka46.com/files/46/diary/n46/MEMBER/moblog/202403/mobkC5T7A.png","alt":""},{"type":"image","src":"https://www.nogizaka46.com/files/46/diary/n46/MEMBER/moblog/202403/mobJBZ0aO.png","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"アップトゥボーイさん Vol.337"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"本日発売です📗📚‎🤍"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"今回表紙巻頭をつとめさせていただいております ありがとうございますm(_ _)m"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph",