break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"ちょっとやばいのかもしれません。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"いぐちまお"}],"source":"archive"}