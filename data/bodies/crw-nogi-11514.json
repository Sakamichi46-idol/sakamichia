ya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0010.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0011.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0012.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0007.gif","alt":""},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0000.jpeg","alt":""},{"type":"break"},{"type":"paragraph","text":"そして昨日は個別握手会が名古屋にてありました"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0003.gif","alt":""},{"type":"paragraph","text":"来てくれた方、ありがとうございました"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0002.gif","alt":""},{"type":"paragraph","text":"そしてお留守番の方も応援してくれてて、ありがとうございました〜"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0005.gif","alt":""},{"type":"break"},{"type":"paragraph","text":"前日の夜に皆でご飯食べに行きました"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0006.gif","alt":""},{"type":"paragraph","text":"『君の名は希望』がBGMで流れました〜"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0008.gif","alt":""},{"type":"paragraph","text":"いくちゃん(生田えりかちゃん)はさっそく歌ってたよ"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0007.gif","alt":""},{"type":"break"},{"type":"paragraph","text":"まいやん(白石まいちゃん)もさゆりん(松村さゆりちゃん)も歌ってた"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0012.gif","alt":""},{"type":"break"},{"type":"paragraph","text":"まいやんは手羽先綺麗に食べれる方法教えてくれた"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0011.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0005.gif","alt":""},{"type":"paragraph","text":"Thank You"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0005.gif","alt":""},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0001.jpeg","alt":""},{"type":"paragraph","text":"（写メが上手にとれなかったけど...）"},{"type":"break"},{"type":"paragraph","text":"前回の答えは...大好きな...\nみなみだよ〜"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0002.gif","alt":""},{"type":"paragraph","text":"ほとんどの方が正解でしたね〜"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0006.gif","alt":""},{"type":"paragraph","text":"問題が優しかったかな♪"},{"type":"break"},{"type":"paragraph","text":"実は...服は色々あってひなちまのを着たよひなちまありがとう"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0004.gif","alt":""},{"type":"break"},{"type":"paragraph","text":"地震大丈夫？ってコメントもありがとう"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0008.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0008.gif","alt":""},{"type":"paragraph","text":"まあやは大丈夫だよ"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0007.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0010.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0011.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0012.gif","alt":""},{"type":"paragraph","text":"皆は怪我とかなかったかな？"},{"type":"break"},{"type":"paragraph","text":"いつも励ましや心配や、大好き"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0005.gif","alt":""},{"type":"paragraph","text":"とか"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0004.gif","alt":""},{"type":"paragraph","text":"時には字の間違いを教えてくれたり、まあやのことが気になってる！ってコメントを書いてくれてたり♪"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0005.gif","alt":""},{"type":"paragraph","text":"嬉しい〜"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0005.gif","alt":""},{"type":"break"},{"type":"paragraph","text":"全部コメントは読んでるんだけど、全部の質問に答えれなくてごめんね"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0008.gif","alt":""},{"type":"paragraph","text":"中には、あ〜答えてないな〜(*_*)大粒涙\nって思う事もあったりします"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0007.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0010.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0011.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0012.gif","alt":""},{"type":"break"},{"type":"paragraph","text":"でも又コメントしてくれてると良かった〜！って思います"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0008.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0009.gif","alt":""},{"type":"paragraph","text":"握手会やコメントで沢山のパワーありがとうございます★"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0007.gif","alt":""},{"type":"paragraph","text":"私のパワーも届きますように"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0007.gif","alt":""},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"そして、ひめたん誕生日おめでとう!!\n同じ広島出身で最初の頃はよく一緒に東京に通ってました"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0006.gif","alt":""},{"type":"break"},{"type":"paragraph","text":"ひめたんは"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0005.gif","alt":""},{"type":"paragraph","text":"アイドル"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0005.gif","alt":""},{"type":"paragraph","text":"って感じでいつも可愛いし、歌もダンスも凄いです"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0004.gif","alt":""},{"type":"break"},{"type":"paragraph","text":"素敵な1年になりますように"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0002.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0003.gif","alt":""},{"type":"paragraph","text":"BYE"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2013/04/15/2731682/0003.gif","alt":""}],"source":"archive"}