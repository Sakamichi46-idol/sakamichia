/08/26/0781865/0002.gif","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"前にもこんなこと書いてたっけー⁇"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"いや、そんなことよりね、"},{"type":"break"},{"type":"paragraph","text":"わたくしはね、"},{"type":"break"},{"type":"paragraph","text":"早くみなさんに会いたいんだよ"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/marika.ito/img/blog/photos/entry/2012/08/26/0781865/0003.gif","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"もーー早くみなさんに会いたいです。"},{"type":"break"},{"type":"paragraph","text":"みなさんに会って元気になりたい。"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"もーすぐ会えるけどねっっ"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"へへ"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/marika.ito/img/blog/photos/entry/2012/08/26/0781865/0004.gif","alt":""},{"type":"paragraph","text":"←"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/marika.ito/img/blog/photos/entry/2012/08/26/0781865/0005.jpeg","alt":""},{"type":"break"},{"type":"paragraph","text":"かいてたらなんかすごいことなった。"},{"type":"break"},{"type":"paragraph","text":"あ、このぐるぐるは髪のボサボサを"},{"type":"break"},{"type":"paragraph","text":"隠してるんでないわよ"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/marika.ito/img/blog/photos/entry/2012/08/26/0781865/0006.gif","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"あー、朝の森に行きたい。"},{"type":"break"},{"type":"paragraph","text":"一人でゆったりぶらぶらしたい。"},{"type":"break"},{"type":"paragraph","text":"かわいいニット帽被って、"},{"type":"break"},{"type":"paragraph","text":"長いふわふわのワンピース着て、"},{"type":"break"},{"type":"paragraph","text":"ぐるんぐるんに"},{"type":"break"},