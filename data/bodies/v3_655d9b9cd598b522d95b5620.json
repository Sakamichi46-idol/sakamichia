ングで"}, {"type": "paragraph", "text": "ちょうどお月様が雲の隙間から"}, {"type": "paragraph", "text": "顔を出していたの"}, {"type": "break"}, {"type": "paragraph", "text": "1人で気づいて"}, {"type": "paragraph", "text": "泣きそうになったよ🌙"}, {"type": "break"}, {"type": "paragraph", "text": "素敵な時間をありがとう"}], "source": "official"}