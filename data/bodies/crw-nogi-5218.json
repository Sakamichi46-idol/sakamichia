{"blocks":[{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"こんばんたーーん( •ㅈ• )"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"明日はいよいよ広島での初ライブ‼"},{"type":"break"},{"type":"paragraph","text":"やっとこの日が来ました☆きゃあ"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"あたしはそもそも広島自体が"},{"type":"break"},{"type":"paragraph","text":"初上陸なので今からすごく"},{"type":"break"},{"type":"paragraph","text":"dkdkしています♡"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"広島の皆さん温かく乃木坂46"},{"type":"break"},{"type":"paragraph","text":"そして斉藤優里を迎えてくれ"},{"type":"break"},{"type":"paragraph","text":"たら嬉しいです(´･ω･`)"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"まあやに広島って どんなとこ？って"},{"type":"break"},{"type":"paragraph","text":"聞いたところ一言で『良いところ』"},{"type":"break"},{"type":"paragraph","text":"と返されました‼"},{"type":"break"},{"type":"paragraph","text":"広島の方期待しとくからね( • ̀ω•́  )✧"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"そしてイベントですがたくさんの"},{"type":"break"},{"type":"paragraph","text":"皆さんに会えるといいな。"},{"type":"break"},{"type":"paragraph","text":"明日行く行くーーー‼っている"},{"type":"break"},{"type":"paragraph","text":"そこのあなた。←え"},{"type":"break"},{"type":"paragraph","text":"家族は勿論、お友達も、大切な人も"},{"type":"break"},{"type":"paragraph","text":"みーんなみんな連れてきちゃって"},{"type":"break"},{"type":"paragraph","text":"ください( •ㅈ• )ぜひぜひ。"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"皆さんが全員楽しかったって"},{"type":"break"},{"type":"paragraph","text":"今日わざわざ足を運んで良かったって"},{"type":"break"},{"type":"paragraph","text":"思ってもらえるように一生懸命"},{"type":"break"},{"type":"paragraph","text":"パフォーマンスします( • ̀ω•́  )✧"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"そしていつも駆けつけてくれる"},{"type":"break"},{"type":"paragraph","text":"ファンの皆さん本当にありがとう"},{"type":"break"},{"type":"paragraph","text":"ございます‼皆さんがいるから"},{"type":"break"},{"type":"paragraph","text":"あたし達は安心してパフォーマンス"},{"type":"break"},{"type":"paragraph","text":"をすることが出来ます(´･ω･`)"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"広島の皆さん待ってろーーーい。"},{"type":"break"},{"type":"paragraph","text":"もうすぐ行くぜいぜい。"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/yuuri.saito/img/blog/photos/entry/2012/06/08/5398625/0000.jpeg","alt":""},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"ほらほらどっかで見たことのある"},{"type":"break"},{"type":"paragraph","text":"眼鏡ちゃんだよう( •ㅈ• )"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"え、どこかって忘れたとは"},{"type":"break"},{"type":"paragraph","text":"言わせないぞ。個人PVでしょう？"},{"type":"break"},{"type":"paragraph","text":"(´･ω･`)"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"たんたんたん ゆったんたん"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"_"}],"source":"archive"}