{"blocks":[{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"こんばんたーーん( •ㅈ• )ちゃす。"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"今日の乃木坂ってどこ⁈では"},{"type":"break"},{"type":"paragraph","text":"皆さんの待ちにまってた3rd"},{"type":"break"},{"type":"paragraph","text":"シングルの選抜発表でした。"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"3回連続で見事選抜に選ばれました。"},{"type":"break"},{"type":"paragraph","text":"めちゃくちゃ嬉しいんです。"},{"type":"break"},{"type":"paragraph","text":"でも正直な気持ちを言ってしまうと"},{"type":"break"},{"type":"paragraph","text":"悔しいんです。"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"今までは言えなかった気持ち。"},{"type":"break"},{"type":"paragraph","text":"でも今の自分なら"},{"type":"break"},{"type":"paragraph","text":"言える気がします。"},{"type":"break"},{"type":"paragraph","text":"あたしだって七福神になりたいです。"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"こんなこと言うのもあれですが"},{"type":"break"},{"type":"paragraph","text":"今までのあたしは選抜に選ばれて"},{"type":"break"},{"type":"paragraph","text":"いても全然自信がつかず、"},{"type":"break"},{"type":"paragraph","text":"たまたま選ばれただけと。"},{"type":"break"},{"type":"paragraph","text":"思っていました。"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"でも最近では皆さんが"},{"type":"break"},{"type":"paragraph","text":"ゆったんの笑顔で元気になれる。"},{"type":"break"},{"type":"paragraph","text":"ゆったんも頑張ってるから"},{"type":"break"},{"type":"paragraph","text":"毎日頑張れるよ。など"},{"type":"break"},{"type":"paragraph","text":"声をかけてくれる方が"},{"type":"break"},{"type":"paragraph","text":"いっぱいいます。"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"そんなあたしを元気の素に"},{"type":"break"},{"type":"paragraph","text":"してくれている皆さんに"},{"type":"break"},{"type":"paragraph","text":"あたしがこんな気持ちで"},{"type":"break"},{"type":"paragraph","text":"満足してはいけないと"},{"type":"break"},{"type":"paragraph","text":"感じました。"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"だからあたしは3rd選抜に選ばれ"},{"type":"break"},{"type":"paragraph","text":"活躍するチャンスをまた貰えたので"},{"type":"break"},{"type":"paragraph","text":"皆さんに恩返しする気持ちも込めて"},{"type":"break"},{"type":"paragraph","text":"またもう、自信のない自分とばいばい"},{"type":"break"},{"type":"paragraph","text":"する為にもいろんなことに励みます。"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"これからは辛いこともあるかも"},{"type":"break"},{"type":"paragraph","text":"しれないですが成長することに"},{"type":"break"},{"type":"paragraph","text":"苦労はつきものです。"},{"type":"break"},{"type":"paragraph","text":"強い心をもって成長するんだ。"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"皆さんの暖かい言葉に"},{"type":"break"},{"type":"paragraph","text":"救われ。厳しい言葉に"},{"type":"break"},{"type":"paragraph","text":"自分を見つめ直し。"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"皆さんがいてくれるから"},{"type":"break"},{"type":"paragraph","text":"斉藤優里はここにいるんです。"},{"type":"break"},{"type":"paragraph","text":"いつもありがとうございます。"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/yuuri.saito/img/blog/yuuri.saito/%E3%82%86%E3%81%86%E3%82%8A%EF%BC%91.jpg","alt":""},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"世界中の国の皆さんが"},{"type":"break"},{"type":"paragraph","text":"笑顔で溢れますように。"},{"type":"break"},{"type":"paragraph","text":"明日もあたしは笑顔です。絶対に。"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"たんたんたん ゆったんたん"},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"."},{"type":"break"},{"type":"paragraph","text":"_"}],"source":"archive"}