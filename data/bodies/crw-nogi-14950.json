ype":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"交通の便とか気になるけどでも雪が見たいのっ！"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"世の中はクリスマスに突入したが、"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"早いよっ！"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"生駒ちゃんまだハロウィン気分"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/rina.ikoma/img/blog/rina.ikoma/img/2013/11/02/8481447/0006.gif","alt":""},{"type":"paragraph","text":"（笑）"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"へばなっ！☆"}],"source":"archive"}