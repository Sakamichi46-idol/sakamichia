953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"以上！今回はここまで〜(^o^)"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0005.jpeg","alt":""},{"type":"break"},{"type":"paragraph","text":"M J"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0001.gif","alt":""},{"type":"paragraph","text":"MUSIC JAPAN\nの時、SEKAI NO OWARIさんがペロペロキャンディーをくださいましたっ♪"},{"type":"break"},{"type":"paragraph","text":"見に来てくれた方\n有り難う御座いました"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0001.gif","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0002.gif","alt":""},{"type":"paragraph","text":"最近は学校行事等で親が来てくれる事がちょこちょこあって、\n仕事の合間に一緒に買い物したり、美味しいもの食べたり♪\nお部屋の掃除をしてもらったり(^w^)笑"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0004.gif","alt":""},{"type":"paragraph","text":"それに、行って来ます！と、ただいま！を言うのが嬉しいな〜って思った(^o^)♪"},{"type":"break"},{"type":"paragraph","text":"皆は家族に言ってる？"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0004.gif","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0001.gif","alt":""},{"type":"paragraph","text":"そして、お茶会に来てくださった方、応募してくださった方\nありがとうございましたm(__)m(#^.^#)\n楽しかったです〜♪"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0004.gif","alt":""},{"type":"paragraph","text":"中には韓国の方が居て、韓国のジャンケンってちょっぴり日本と違うんだなっ！て思った！笑"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"paragraph","text":"帰ってすぐにお母さんとお祖母ちゃんにも教えたよ(^o^) ♪"},{"type":"break"},{"type":"break"},{"type":"paragraph","text":"本当に皆 遠くから来てくれたり、楽しい時間をありがとうございました(*≧∀≦*)"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0004.gif","alt":""},{"type":"paragraph","text":"その日は、西川ななみちゃんのお別れの日だったけど、辞めてもずっと大切なメンバーだと思ってる"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0004.gif","alt":""},{"type":"paragraph","text":"だから応援してるし、まあやも頑張るよ！忘れないでね！p(^-^)q"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0001.gif","alt":""},{"type":"paragraph","text":"前回、沢山の卒業おめでとうコメントや乃木どこの感想をありがとうございす。m(__)m(*≧∀≦*)"},{"type":"break"},{"type":"paragraph","text":"皆にまあやのパワーが届きますようにo(^o^)o"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0001.gif","alt":""},{"type":"paragraph","text":"前ひなちゃんの誕生日でケーキが用意されて、仕事終わったら食べるってなって、\nでも誕生日本人のひなちゃんはケーキ食べなくて、"},{"type":"break"},{"type":"paragraph","text":"いつもならほかのメンバーも食べて、一瞬で無くなるのに、\nその日に限ってまあやと飛鳥とマネージャーしか居なくて......"},{"type":"break"},{"type":"paragraph","text":"３人で、ひなちゃんの誕生日ケーキ"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"paragraph","text":"しかもホールのを食べる事になって、\n飛鳥はほとんど食べなくて、"},{"type":"break"},{"type":"paragraph","text":"マネージャーとまあやで食べました..."},{"type":"break"},{"type":"paragraph","text":"美味しいけど...\n食べ過ぎたよ〜ひなちゃん〜(T-T)"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0004.gif","alt":""},{"type":"paragraph","text":"それと、最後に\nいちきちゃんのファミリーになった、"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0004.gif","alt":""},{"type":"paragraph","text":"ゆきみちゃん〜"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0004.gif","alt":""},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0002.gif","alt":""},{"type":"paragraph","text":"和田家でも可愛い〜(*≧∀≦*)って話題になってるよ〜♪\n抱っこしたいなぁ〜( 〃▽〃)"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"paragraph","text":"ほんとかわいいワンちゃん♪"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0002.gif","alt":""},{"type":"paragraph","text":"なんでゆきみちゃんって名前なんだろ......(´・ω・`)？笑"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0003.gif","alt":""},{"type":"paragraph","text":"皆ペット飼ってる？\n何て名前なの〜？♪"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0001.gif","alt":""},{"type":"paragraph","text":"BYE"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/maaya.wada/img/files/46/_pre/blog/maaya.wada/img/2014/03/25/5038953/0001.gif","alt":""}],"source":"archive"}