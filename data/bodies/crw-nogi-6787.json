/2012/08/24/1855448/0004.gif","alt":""},{"type":"break"},{"type":"paragraph","text":"頑張ってください‼"},{"type":"break"},{"type":"paragraph","text":"私も見たい"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/marika.ito/img/blog/photos/entry/2012/08/24/1855448/0005.gif","alt":""},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/marika.ito/img/blog/photos/entry/2012/08/24/1855448/0001.gif","alt":""},{"type":"paragraph","text":"井上真央に似てるって"},{"type":"break"},{"type":"paragraph","text":"言われへん？"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/marika.ito/img/blog/photos/entry/2012/08/24/1855448/0002.jpeg","alt":""},{"type":"paragraph","text":"乃木坂のオーディションの時から"},{"type":"break"},{"type":"paragraph","text":"言われること多くなりました><"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/marika.ito/img/blog/photos/entry/2012/08/24/1855448/0001.gif","alt":""},{"type":"paragraph","text":"「走れ！Bicycle」は何て"},{"type":"break"},{"type":"paragraph","text":"略せばいいのかな？"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/marika.ito/img/blog/photos/entry/2012/08/24/1855448/0002.jpeg","alt":""},{"type":"paragraph","text":"バイシクルって言ってるなぁ私。"},{"type":"break"},{"type":"paragraph","text":"はしバイ、チャリ走、はしチャリ..."},{"type":"break"},{"type":"paragraph","text":"いっぱいあるね‼"},{"type":"break"},{"type":"break"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/marika.ito/img/blog/photos/entry/2012/08/24/1855448/0001.gif","alt":""},{"type":"paragraph","text":"悩む時ゎとことん悩むタイプ？"},{"type":"break"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/marika.ito/img/blog/photos/entry/2012/08/24/1855448/0002.jpeg","alt":""},{"type":"paragraph","text":"うん...けっこう引きずる方かな"},{"type":"image","src":"https://janelin612.github.io/n46-crawler/mb/marika.ito/img/blog/photos/entry/201